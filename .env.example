# 复制为 .env.local 并填写。此文件只放空占位符，任何真实密钥都不得提交。

# 高德 Web 服务 Key（服务端：地点检索、路线规划、天气）。不要加 NEXT_PUBLIC_ 前缀。
AMAP_WEB_SERVICE_KEY=

# 高德 JS API Key（浏览器地图，可公开；请在高德控制台限制域名）
NEXT_PUBLIC_AMAP_JS_KEY=

# 高德 JS 安全密钥（仅服务端，经 /_AMapService 代理注入，不暴露给浏览器）
AMAP_JS_SECURITY_CODE=

# 大模型（OpenAI 兼容接口，需支持 Function Calling）。二选一填写密钥即可。
# 默认 https://api.deepseek.com + deepseek-flash
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 视觉模型（拍照识景，可选）。OpenAI 兼容的多模态接口，默认智谱 GLM-4V-Flash。
# 不填时该功能显示“暂未开启”，其他功能不受影响。
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
