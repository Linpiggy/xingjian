# Copy variable names into .env.local. NEVER put real credentials in this tracked file.
# Server-only Web service key. Never use NEXT_PUBLIC_ for this credential.
AMAP_WEB_SERVICE_KEY=

# Separate JS API key: public client identifier; configure allowed domains in Amap.
NEXT_PUBLIC_AMAP_JS_KEY=

# Private JS security code: injected by the same-origin _AMapService proxy only.
AMAP_JS_SECURITY_CODE=
