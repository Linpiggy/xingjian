# Copy variable names into .env.local. NEVER put real credentials in this tracked file.
# Server-only Web service key. Never use NEXT_PUBLIC_ for this credential.
AMAP_WEB_SERVICE_KEY=

# Separate JS API key: public client identifier; configure allowed domains in Amap.
NEXT_PUBLIC_AMAP_JS_KEY=

# Private JS security code: injected by the same-origin _AMapService proxy only.
AMAP_JS_SECURITY_CODE=

# Server-only OpenAI-compatible model. Set either OPENAI_API_KEY or DEEPSEEK_API_KEY.
# Defaults: https://api.deepseek.com, model deepseek-flash. No value may go in NEXT_PUBLIC_.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional server-owned reviewed social reference catalog, relative to this repository.
# JSON index with modelUseConfirmed=true; not raw crawled exports or a browser upload.
# Leave empty until lawful source data is prepared. No crawler is launched by the app.
SOCIAL_REFERENCE_FILE=

# Server-only PostgreSQL connection. Use a dedicated local project database.
# Configure in .env.local; never paste the connection string into chat or logs.
# Dependency installation does not run migrations or connect to this database.
DATABASE_URL=

# Server-only account API Host (*.qweatherapi.com). Select JWT OR API key, not both.
# A pre-generated JWT is supported; no private signing key is read by the application.
# Real weather requests require separate authorization; leave empty for offline tests.
QWEATHER_API_HOST=
QWEATHER_JWT=
QWEATHER_API_KEY=
