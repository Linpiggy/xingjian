{
  "name": "xingjian-travel-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests scripts *.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "secrets": "node scripts/check-secrets.mjs",
    "format": "prettier --write src tests scripts \"*.{json,ts,mjs}\" .prettierrc.json",
    "format:check": "prettier --check src tests scripts \"*.{json,ts,mjs}\" .prettierrc.json",
    "check": "npm run secrets && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "browser:install": "node scripts/playwright.mjs install chromium --only-shell",
    "e2e": "node scripts/playwright.mjs test",
    "smoke:live": "node scripts/smoke-live.mjs",
    "smoke:recommendation": "node scripts/smoke-recommendation-live.mjs",
    "smoke:map": "node scripts/smoke-recommendation-live.mjs --map-only"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "1.0.1",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@amap/amap-jsapi-types": "0.0.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
